# Application Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=dev-secret-key-change-in-production-12345
DEBUG=True

# Database Configuration
# Default SQLite: sqlite:///instance/wellness.db (Leave blank to use default)
DATABASE_URL=
# For PostgreSQL / Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For MySQL: mysql+pymysql://user:password@localhost:3306/wellness_ai

# Google OAuth2 Authentication (Get from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI to register in Google Cloud: http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For local dev: http://127.0.0.1:5000/auth/google/callback or http://localhost:5000/auth/google/callback
# For production: https://yourdomain.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Sign in with Apple Authentication (Apple Developer Portal -> Certificates, Identifiers & Profiles)
# Return URL to configure in Apple Services ID: http://127.0.0.1:5000/auth/apple/callback
# APPLE_CLIENT_ID: Your Apple Services ID (e.g. com.vitalis.wellness.service)
APPLE_CLIENT_ID=your-apple-services-id
# APPLE_TEAM_ID: Your 10-character Apple Developer Team ID
APPLE_TEAM_ID=your-apple-team-id
# APPLE_KEY_ID: Your 10-character Key ID for the Sign in with Apple private key
APPLE_KEY_ID=your-apple-key-id
# APPLE_PRIVATE_KEY: Path to .p8 private key file or inline PEM-formatted string
APPLE_PRIVATE_KEY=your-apple-private-key-path-or-pem
APPLE_REDIRECT_URI=http://127.0.0.1:5000/auth/apple/callback

# Machine Learning & Models
MODEL_DIR=models/production
REGISTRY_PATH=models/model_registry.json
DATA_DIR=data
ENABLE_ANOMALY_DETECTION=True

# Wellness Score Component Weights (must sum to 1.0)
WEIGHT_ACTIVITY=0.25
WEIGHT_HYDRATION=0.20
WEIGHT_SLEEP=0.20
WEIGHT_TASKS=0.20
WEIGHT_CONSISTENCY=0.15

# Logging
LOG_LEVEL=INFO

# Phone Number & SMS / OTP Authentication
# Options: 'mock' (default for development/testing) or 'twilio' (production)
SMS_PROVIDER=mock
# Twilio credentials (required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
